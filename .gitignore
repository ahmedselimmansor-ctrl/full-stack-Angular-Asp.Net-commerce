# ---- .NET ----
bin/
obj/
*.user
*.suo
artifacts/
TestResults/
coverage/
*.received.*

# ---- Node / Angular ----
node_modules/
dist/
.angular/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ---- Android / Kotlin ----
.gradle/
# Scoped to the Gradle modules on purpose. A bare `build/` also matched the
# top-level build/ directory, which holds the Dockerfiles, nginx.conf and the
# migration runner -- and the `!build/docker/` negation that followed could not
# rescue them, because git cannot re-include anything inside an excluded
# directory. The result was a repository with no Dockerfiles in it, which only
# shows up when someone builds an image from a fresh clone.
src/mobile/sama-android/build/
src/mobile/sama-android/*/build/
local.properties
*.apk
*.aab
*.keystore
.cxx/
# The wrapper jar is committed on purpose: it is what lets a fresh checkout build without
# Gradle already installed, and it is the mechanism the wrapper's own integrity check verifies.
!gradle/wrapper/gradle-wrapper.jar

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log

# ---- Secrets & local env ----
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
secrets/
appsettings.Local.json
sa-key*.json

# ---- Editors / OS ----
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Local run logs from scripts/run-local.sh
.logs/

# ---- Android build outputs & local SDK path ----
src/mobile/sama-android/local.properties
src/mobile/sama-android/.kotlin/

# ---- Playwright ----
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/.playwright/
