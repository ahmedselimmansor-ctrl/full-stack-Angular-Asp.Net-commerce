# Angular storefront, served by nginx.
#
# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
WORKDIR /src

# package files first, so a source change does not re-run npm ci.
COPY src/web/sama-web/package*.json ./
RUN npm ci --no-audit --no-fund

COPY src/web/sama-web/ ./
RUN npm run build -- --configuration production

# ---------------------------------------------------------------------------------------
# nginx-unprivileged: listens on 8080 and runs as UID 101, so the container needs no
# capabilities and satisfies the restricted Pod Security Standard.
# ---------------------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS final

COPY --chown=101:101 build/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=101:101 /src/dist/sama-web/browser /usr/share/nginx/html

EXPOSE 8080
USER 101
