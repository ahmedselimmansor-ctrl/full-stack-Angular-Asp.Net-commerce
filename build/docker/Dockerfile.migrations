# Applies every service's EF Core migrations, as a Kubernetes Job that runs before the new
# version's pods roll out.
#
# `dotnet ef migrations bundle` produces a self-contained executable per context, so the
# runtime image needs neither the SDK nor the EF tooling.
#
# syntax=docker/dockerfile:1.7
ARG DOTNET_VERSION=10.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-noble AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props NuGet.config global.json .editorconfig ./
COPY src/ src/

RUN dotnet tool install --global dotnet-ef --version 10.0.11
ENV PATH="/root/.dotnet/tools:${PATH}"

# One bundle per context. Ordering matters at run time, not here.
RUN for service in Identity Catalog Ordering Inventory Payment; do \
      dotnet ef migrations bundle \
        --project "src/services/Sama.${service}/Sama.${service}.csproj" \
        --configuration Release \
        --self-contained --runtime linux-x64 \
        --output "/bundles/migrate-${service}" \
        --force ; \
    done

# ---------------------------------------------------------------------------------------
# This image keeps a shell, unlike the service images.
#
# The job runs five bundles in sequence and must stop at the first failure, which needs a
# shell. The trade is acceptable here and not for the services: this container exists for
# seconds during a deploy, has no network exposure, and is not a foothold anything can reach.
# ---------------------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/runtime-deps:${DOTNET_VERSION}-noble AS final

WORKDIR /app
COPY --from=build --chown=1654:1654 /bundles/ ./
COPY --chown=1654:1654 build/docker/run-migrations.sh ./run-migrations.sh
RUN chmod +x ./run-migrations.sh ./migrate-*

USER 1654
ENTRYPOINT ["./run-migrations.sh"]
