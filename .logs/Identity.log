SELECT u1.id, u1.access_failed_count, u1.created_at, u1.created_by, u1.deleted_at, u1.deleted_by, u1.display_name, u1.email, u1.email_confirmed, u1.is_active, u1.is_deleted, u1.last_login_at, u1.lockout_ends_at, u1.normalized_email, u1.password_hash, u1.security_stamp, u1.tenant_id, u1.updated_at, u1.updated_by, u1.xmin, u0.user_id, u0.role
FROM (
    SELECT u.id, u.access_failed_count, u.created_at, u.created_by, u.deleted_at, u.deleted_by, u.display_name, u.email, u.email_confirmed, u.is_active, u.is_deleted, u.last_login_at, u.lockout_ends_at, u.normalized_email, u.password_hash, u.security_stamp, u.tenant_id, u.updated_at, u.updated_by, u.xmin
