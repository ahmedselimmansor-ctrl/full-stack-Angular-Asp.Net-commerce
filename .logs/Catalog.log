SELECT p1.id, p1.brand, p1.category_id, p1.created_at, p1.created_by, p1.currency, p1.deleted_at, p1.deleted_by, p1.description, p1.is_deleted, p1.name, p1.price, p1.search_vector, p1.sku, p1.slug, p1.status, p1.tenant_id, p1.updated_at, p1.updated_by, p1.xmin, p0.product_id, p0.url, p0.alt_text, p0.sort_order
FROM (
    SELECT p.id, p.brand, p.category_id, p.created_at, p.created_by, p.currency, p.deleted_at, p.deleted_by, p.description, p.is_deleted, p.name, p.price, p.search_vector, p.sku, p.slug, p.status, p.tenant_id, p.updated_at, p.updated_by, p.xmin
    FROM catalog.products AS p
    WHERE NOT (p.is_deleted) AND (@ef_filter__p2 OR p.tenant_id = @ef_filter__CurrentTenantId) AND p.id = @id
    LIMIT 1
) AS p1
LEFT JOIN catalog.product_images AS p0 ON p1.id = p0.product_id
ORDER BY p1.id, p0.product_id
