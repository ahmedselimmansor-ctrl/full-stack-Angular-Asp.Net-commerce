{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "Postgres": ""
  },

  "Redis": {
    "ConnectionString": "",
    "InstanceName": "sama-identity",
    "UseTls": true,
    "ConnectTimeoutMs": 5000,
    "OperationTimeoutMs": 1000
  },

  "Signing": {
    "Issuer": "",
    "Audience": "sama-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "ActiveKeyId": "",
    "Keys": []
  },

  "Auth": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "RequireConfirmedEmail": false
  },

  "Tenancy": {
    "DefaultTenantId": "0192f000-0000-7000-8000-000000000001",
    "Hosts": {}
  },

  "RateLimiting": {
    "Enabled": true,
    "FailOpen": true,
    "Policies": {
      "auth-login": {
        "PermitLimit": 5,
        "WindowSeconds": 300,
        "Partition": "IpAndSubject"
      },
      "auth-register": {
        "PermitLimit": 3,
        "WindowSeconds": 3600,
        "Partition": "IpAddress"
      },
      "auth-refresh": {
        "PermitLimit": 30,
        "WindowSeconds": 300,
        "Partition": "IpAddress"
      },
      "read": {
        "PermitLimit": 600,
        "WindowSeconds": 60,
        "Partition": "User"
      },
      "write": {
        "PermitLimit": 60,
        "WindowSeconds": 60,
        "Partition": "User"
      }
    }
  },

  "PubSub": {
    "ProjectId": "",
    "TopicPrefix": "sama"
  },

  "Outbox": {
    "PollIntervalMs": 500,
    "BatchSize": 50,
    "MaxAttempts": 10,
    "MaxBackoffSeconds": 300
  },

  "ClientIp": {
    "TrustedHeader": "X-Client-IP",
    "TrustProxyHeader": true
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Telemetry": {
    "SamplingRatio": 0.1
  },

  "GoogleCloud": {
    "ProjectId": ""
  },

  "AllowedHosts": "*"
}
