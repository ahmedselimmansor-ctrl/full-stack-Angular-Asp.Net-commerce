{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "sama-basket",
    "UseTls": true,
    "ConnectTimeoutMs": 5000,
    "OperationTimeoutMs": 1000
  },
  "Tenancy": {
    "DefaultTenantId": "0192f000-0000-7000-8000-000000000001",
    "Hosts": {}
  },
  "RateLimiting": {
    "Enabled": true,
    "FailOpen": true,
    "Policies": {
      "read": {
        "PermitLimit": 600,
        "WindowSeconds": 60,
        "Partition": "User"
      },
      "write": {
        "PermitLimit": 60,
        "WindowSeconds": 60,
        "Partition": "User"
      },
      "search": {
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "Partition": "User"
      }
    }
  },
  "PubSub": {
    "ProjectId": "",
    "TopicPrefix": "sama"
  },
  "ClientIp": {
    "TrustedHeader": "X-Client-IP",
    "TrustProxyHeader": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Telemetry": {
    "SamplingRatio": 0.1
  },
  "GoogleCloud": {
    "ProjectId": ""
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "",
    "Audience": "sama-api",
    "Issuer": "",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "Basket": {
    "RetentionDays": 30,
    "GuestRetentionDays": 7,
    "MaxQuantityPerLine": 20,
    "MaxLines": 100,
    "MaxSaveAttempts": 4
  },
  "Services": {
    "Catalog": ""
  },
  "Subscriber": {
    "Subscriptions": [
      "basket-ordering"
    ],
    "DeduplicationRetentionHours": 24
  }
}
