{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "sama-gateway",
    "UseTls": true,
    "ConnectTimeoutMs": 5000,
    "OperationTimeoutMs": 1000
  },
  "Tenancy": {
    "DefaultTenantId": "0192f000-0000-7000-8000-000000000001",
    "Hosts": {}
  },
  "RateLimiting": {
    "Enabled": true,
    "FailOpen": false,
    "Policies": {
      "auth-login": {
        "PermitLimit": 5,
        "WindowSeconds": 300,
        "Partition": "IpAndSubject"
      },
      "auth-register": {
        "PermitLimit": 3,
        "WindowSeconds": 3600,
        "Partition": "IpAddress"
      },
      "auth-refresh": {
        "PermitLimit": 30,
        "WindowSeconds": 300,
        "Partition": "IpAddress"
      },
      "read": {
        "PermitLimit": 600,
        "WindowSeconds": 60,
        "Partition": "User"
      },
      "write": {
        "PermitLimit": 60,
        "WindowSeconds": 60,
        "Partition": "User"
      },
      "search": {
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "Partition": "User"
      },
      "checkout": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "Partition": "User"
      }
    }
  },
  "PubSub": {
    "ProjectId": "",
    "TopicPrefix": "sama"
  },
  "ClientIp": {
    "TrustedHeader": "X-Client-IP",
    "TrustProxyHeader": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Telemetry": {
    "SamplingRatio": 0.1
  },
  "GoogleCloud": {
    "ProjectId": ""
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "",
    "Audience": "sama-api",
    "Issuer": "",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/auth/login",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "RateLimitPolicy": "auth-login"
        }
      },
      "auth-register": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/auth/register",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "RateLimitPolicy": "auth-register"
        }
      },
      "auth-refresh": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/auth/refresh",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "RateLimitPolicy": "auth-refresh"
        }
      },
      "auth": {
        "ClusterId": "identity",
        "Order": -90,
        "Match": {
          "Path": "/api/v1/auth/{**rest}"
        },
        "Metadata": {
          "RateLimitPolicy": "write"
        }
      },
      "discovery": {
        "ClusterId": "identity",
        "Order": -90,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/.well-known/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Metadata": {
          "RateLimitPolicy": "read"
        }
      },
      "users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/users/{**rest}"
        },
        "Metadata": {
          "RateLimitPolicy": "write"
        }
      },
      "product-search": {
        "ClusterId": "catalog",
        "Order": -80,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/products",
          "Methods": [
            "GET"
          ]
        },
        "Metadata": {
          "RateLimitPolicy": "search"
        }
      },
      "products": {
        "ClusterId": "catalog",
        "Order": -70,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/products/{**rest}"
        },
        "Metadata": {
          "RateLimitPolicy": "read"
        }
      },
      "categories": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/categories/{**rest}"
        },
        "Metadata": {
          "RateLimitPolicy": "read"
        }
      },
      "basket": {
        "ClusterId": "basket",
        "Match": {
          "Path": "/api/v1/basket/{**rest}"
        },
        "Metadata": {
          "RateLimitPolicy": "write"
        }
      },
      "checkout": {
        "ClusterId": "ordering",
        "Order": -60,
        "Match": {
          "Path": "/api/v1/orders",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "RateLimitPolicy": "checkout"
        }
      },
      "orders": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/orders/{**rest}"
        },
        "Metadata": {
          "RateLimitPolicy": "read"
        }
      },
      "stock": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/v1/stock/{**rest}"
        },
        "Metadata": {
          "RateLimitPolicy": "read"
        }
      },
      "payments": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/v1/payments/{**rest}"
        },
        "Metadata": {
          "RateLimitPolicy": "read"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "LoadBalancingPolicy": "LeastRequests"
      },
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "LoadBalancingPolicy": "LeastRequests"
      },
      "basket": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "LoadBalancingPolicy": "LeastRequests"
      },
      "ordering": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "LoadBalancingPolicy": "LeastRequests"
      },
      "inventory": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "LoadBalancingPolicy": "LeastRequests"
      },
      "payment": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "LoadBalancingPolicy": "LeastRequests"
      }
    }
  }
}
