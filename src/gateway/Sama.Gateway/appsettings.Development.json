{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Redis": {
    "ConnectionString": "localhost:56379",
    "InstanceName": "sama-gateway-dev",
    "UseTls": false
  },
  "Tenancy": {
    "DefaultTenantId": "0192f000-0000-7000-8000-000000000001"
  },
  "PubSub": {
    "ProjectId": "sama-local",
    "TopicPrefix": "sama",
    "EmulatorHost": "localhost:8085"
  },
  "ClientIp": {
    "TrustProxyHeader": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200",
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ]
  },
  "Telemetry": {
    "SamplingRatio": 1.0
  },
  "GoogleCloud": {
    "ProjectId": "sama-local"
  },
  "Jwt": {
    "Authority": "http://localhost:8081",
    "Audience": "sama-api",
    "Issuer": "http://localhost:8081",
    "RequireHttpsMetadata": false,
    "ClockSkewSeconds": 30
  },
  "RateLimiting": {
    "FailOpen": true,
    "Policies": {
      "auth-register": {
        "PermitLimit": 200,
        "WindowSeconds": 3600,
        "Partition": "IpAddress"
      },
      "auth-login": {
        "PermitLimit": 50,
        "WindowSeconds": 300,
        "Partition": "IpAndSubject"
      },
      "auth-refresh": {
        "PermitLimit": 600,
        "WindowSeconds": 300,
        "Partition": "IpAddress"
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:8081"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:8082"
          }
        }
      },
      "basket": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:8083"
          }
        }
      },
      "ordering": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:8084"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:8086"
          }
        }
      },
      "payment": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:8087"
          }
        }
      }
    }
  }
}
